# Namen van de omgevingsvariabelen van de community-app. Geen waarden in dit bestand.
# Alles met VITE_ komt in de browser terecht: zet hier nooit een geheime sleutel in.
# Lokaal: kopieer naar .env.local en vul in. Productie: Vercel, Environment Variables.

VITE_SUPABASE_URL=
# De openbare (publishable) sleutel, niet de service- of secret-sleutel
VITE_SUPABASE_ANON_KEY=
VITE_MAIN_DOMAIN=
# Leeg laten zet Sentry uit
VITE_SENTRY_DSN=

# Geheimen van de edge functions staan niet hier maar in Supabase (supabase secrets set):
# RESEND_API_KEY, FROM_EMAIL, FROM_NAME, MAIN_DOMAIN, APP_BASE_URL, UNSUBSCRIBE_SECRET,
# MOLLIE_CLIENT_ID, MOLLIE_CLIENT_SECRET, MOLLIE_REDIRECT_URI, VAPID_PUBLIC_KEY,
# VAPID_PRIVATE_KEY, VAPID_SUBJECT, LEADS_NOTIFY_EMAILS, BACKUP_ALERT_EMAIL,
# TRANSIP_LOGIN, TRANSIP_PRIVATE_KEY, VERCEL_TOKEN, VERCEL_PROJECT_ID
